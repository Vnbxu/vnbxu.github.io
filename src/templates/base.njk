<!doctype html>
<!-- Generated by npm run build. Edit content/, src/templates/ and assets/ instead. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }} · {{ site.name }}</title>
  <meta name="description" content="{{ page.description }}">
  <meta name="theme-color" content="#faf9f6">
  <link rel="canonical" href="{{ site.url }}/{{ page.path }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ site.name }} · {{ page.title }}">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="{{ site.url }}/{{ page.path }}">
  <meta property="og:image" content="{{ site.url }}/{{ site.portrait }}">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="{{ site.favicon }}" type="image/png">
  <link rel="stylesheet" href="assets/css/site.css?v={{ asset_versions.css }}">
  {% block scripts %}{% endblock %}
</head>
<body class="{{ page.body_class }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="index.html">{{ site.name }}</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href="index.html"{% if page.path == 'index.html' %} aria-current="page"{% endif %}>Home</a>
        <a href="publications.html"{% if page.path == 'publications.html' %} aria-current="page"{% endif %}>Publications</a>
        <a class="nav-contact" href="mailto:{{ site.email }}">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>
  <main class="shell" id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>
  <footer class="shell site-footer">
    <span>© {{ site.copyright_year }} {{ site.name }} <span class="footer-cn" lang="zh-CN">{{ site.name_cn }}</span></span>
    <span>Last updated: <time datetime="{{ page.updated }}">{{ page.updated | updateDate }}</time></span>
  </footer>
</body>
</html>
